<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SumScription.App.ViewModels"
        x:Class="SumScription.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="SumScription"
        Width="420"
        Height="700"
        MinWidth="390"
        MinHeight="650"
        Icon="/Assets/app-icon.ico"
        Background="{DynamicResource WindowBackdropBrush}"
        TransparencyLevelHint="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="48"
        FontFamily="{StaticResource SansFont}"
        WindowStartupLocation="CenterScreen">

  <Panel Background="{DynamicResource WindowBackdropBrush}">
    <Grid RowDefinitions="54,*,Auto"
          Margin="20,10,20,18"
          IsEnabled="{Binding !IsOverlayOpen}">
      <Grid Grid.Row="0"
            Background="Transparent"
            VerticalAlignment="Stretch"
            PointerPressed="OnTitleBarPointerPressed">
        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
          <Border Width="28" Height="28" CornerRadius="9"
                  Background="{DynamicResource OperatorBrush}">
            <TextBlock Text="=" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource OperatorTextBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="SumScription" FontSize="17" FontWeight="SemiBold"
                     VerticalAlignment="Center" />
        </StackPanel>
      </Grid>

      <!-- The display is the main quiet glass surface; history stays secondary. -->
      <Border Grid.Row="1" Margin="0,4,0,14" CornerRadius="26"
              Background="{DynamicResource GlassStrongBrush}"
              BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1"
              ClipToBounds="True">
        <Grid RowDefinitions="Auto,112,*" Margin="22,18,22,16">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
            <TextBlock Classes="meta tertiary" Text="History" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="glass" Content="C" Width="34" Height="30" Padding="0"
                    TabIndex="1" AutomationProperties.Name="Clear entry"
                    Command="{Binding ClearEntryCommand}" />
            <Button Grid.Column="2" Classes="glass" Content="⌫" Width="34" Height="30" Padding="0"
                    TabIndex="2" AutomationProperties.Name="Backspace"
                    Command="{Binding BackspaceCommand}" />
          </Grid>

          <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="0,10,0,0">
            <TextBlock Classes="expression" Text="{Binding ExpressionText}"
                       AutomationProperties.Name="Expression" />
            <Grid Grid.Row="1">
              <TextBlock Name="ResultLine" Classes="result"
                         Classes.masked="{Binding IsResultMasked}"
                         Text="{Binding DisplayResult}"
                         IsVisible="{Binding !HasError}"
                         AutomationProperties.Name="{Binding ResultAutomationName}"
                         VerticalAlignment="Bottom">
                <TextBlock.Transitions>
                  <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.18" /></Transitions>
                </TextBlock.Transitions>
              </TextBlock>
              <TextBlock Name="ErrorLine" Classes="error" Text="{Binding DisplayResult}"
                         IsVisible="{Binding HasError}" AutomationProperties.Name="Error"
                         VerticalAlignment="Bottom" />
              <Border IsVisible="{Binding IsResultMasked}"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,2,8" Padding="10,6" CornerRadius="10"
                      Background="{DynamicResource OperatorBrush}">
                <TextBlock Text="LOCKED" FontSize="10" FontWeight="Bold" LetterSpacing="0.7"
                           Foreground="{DynamicResource OperatorTextBrush}" />
              </Border>
            </Grid>
          </Grid>

          <ScrollViewer Grid.Row="2" Margin="0,10,0,0" MinHeight="52" MaxHeight="112"
                        VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <Panel>
              <TextBlock Classes="history tertiary" Text="No calculations yet"
                         IsVisible="{Binding IsHistoryEmpty}" />
              <ItemsControl ItemsSource="{Binding History}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HistoryRow">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,3" Opacity="{Binding Opacity}">
                      <TextBlock Classes="history" Text="{Binding Expression}"
                                 AutomationProperties.Name="{Binding AutomationName}" />
                      <TextBlock Grid.Column="1" Classes="history-result" Margin="14,0,0,0"
                                 Text="{Binding ResultText}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Panel>
          </ScrollViewer>
        </Grid>
      </Border>

      <Grid Name="Keypad" Grid.Row="2"
            RowDefinitions="60,60,60,60,60"
            ColumnDefinitions="*,*,*,*"
            RowSpacing="8" ColumnSpacing="8">
        <Button Name="AcButton" Grid.Row="0" Grid.Column="0" Classes="calc function" Content="AC" TabIndex="3"
                AutomationProperties.Name="Clear all" Command="{Binding ClearAllCommand}" />
        <Button Grid.Row="0" Grid.Column="1" Classes="calc function" Content="±" TabIndex="4"
                AutomationProperties.Name="Toggle sign" Command="{Binding ToggleSignCommand}" />
        <Button Grid.Row="0" Grid.Column="2" Classes="calc function" Content="%" TabIndex="5"
                AutomationProperties.Name="Premium percent" Command="{Binding PercentCommand}" />
        <Button Grid.Row="0" Grid.Column="3" Classes="calc operator" Content="÷" TabIndex="6"
                AutomationProperties.Name="Divide" Command="{Binding OperatorCommand}" CommandParameter="/" />

        <Button Grid.Row="1" Grid.Column="0" Classes="calc digit" Content="7" TabIndex="7"
                AutomationProperties.Name="Seven" Command="{Binding DigitCommand}" CommandParameter="7" />
        <Button Grid.Row="1" Grid.Column="1" Classes="calc digit" Content="8" TabIndex="8"
                AutomationProperties.Name="Eight" Command="{Binding DigitCommand}" CommandParameter="8" />
        <Button Grid.Row="1" Grid.Column="2" Classes="calc digit" Content="9" TabIndex="9"
                AutomationProperties.Name="Nine" Command="{Binding DigitCommand}" CommandParameter="9" />
        <Button Grid.Row="1" Grid.Column="3" Classes="calc operator" Content="×" TabIndex="10"
                AutomationProperties.Name="Multiply" Command="{Binding OperatorCommand}" CommandParameter="*" />

        <Button Grid.Row="2" Grid.Column="0" Classes="calc digit" Content="4" TabIndex="11"
                AutomationProperties.Name="Four" Command="{Binding DigitCommand}" CommandParameter="4" />
        <Button Grid.Row="2" Grid.Column="1" Classes="calc digit" Content="5" TabIndex="12"
                AutomationProperties.Name="Five" Command="{Binding DigitCommand}" CommandParameter="5" />
        <Button Grid.Row="2" Grid.Column="2" Classes="calc digit" Content="6" TabIndex="13"
                AutomationProperties.Name="Six" Command="{Binding DigitCommand}" CommandParameter="6" />
        <Button Grid.Row="2" Grid.Column="3" Classes="calc operator" Content="−" TabIndex="14"
                AutomationProperties.Name="Minus" Command="{Binding OperatorCommand}" CommandParameter="-" />

        <Button Grid.Row="3" Grid.Column="0" Classes="calc digit" Content="1" TabIndex="15"
                AutomationProperties.Name="One" Command="{Binding DigitCommand}" CommandParameter="1" />
        <Button Grid.Row="3" Grid.Column="1" Classes="calc digit" Content="2" TabIndex="16"
                AutomationProperties.Name="Two" Command="{Binding DigitCommand}" CommandParameter="2" />
        <Button Grid.Row="3" Grid.Column="2" Classes="calc digit" Content="3" TabIndex="17"
                AutomationProperties.Name="Three" Command="{Binding DigitCommand}" CommandParameter="3" />
        <Button Grid.Row="3" Grid.Column="3" Classes="calc operator" Content="+" TabIndex="18"
                AutomationProperties.Name="Plus" Command="{Binding OperatorCommand}" CommandParameter="+" />

        <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Classes="calc digit" Content="0" TabIndex="19"
                AutomationProperties.Name="Zero" Command="{Binding DigitCommand}" CommandParameter="0" />
        <Button Grid.Row="4" Grid.Column="2" Classes="calc digit" Content="," TabIndex="20"
                AutomationProperties.Name="Decimal separator" Command="{Binding SeparatorCommand}" />
        <Button Grid.Row="4" Grid.Column="3" Classes="calc operator" Content="=" TabIndex="21"
                AutomationProperties.Name="Equals" Command="{Binding EqualsCommand}" />
      </Grid>

    </Grid>

    <Button Name="UnlockButton" Classes="offer-bubble" TabIndex="22"
            ZIndex="2"
            Width="58" Height="64"
            Margin="6,150,0,0"
            HorizontalAlignment="Left" VerticalAlignment="Top"
            IsVisible="{Binding IsShopIconVisible}"
            AutomationProperties.Name="Open premium shop"
            ToolTip.Tip="Open premium shop"
            Command="{Binding OpenPaywallCommand}">
      <Grid RowDefinitions="*,Auto">
        <Grid>
          <TextBlock Text="💎" FontSize="27"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Border Width="18" Height="18" CornerRadius="9"
                  Margin="0,-4,-5,0"
                  HorizontalAlignment="Right" VerticalAlignment="Top"
                  Background="{DynamicResource PaywallHotBrush}"
                  BorderBrush="White" BorderThickness="1">
            <TextBlock Text="!" FontSize="11" FontWeight="Black"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="White" />
          </Border>
        </Grid>
        <Border Grid.Row="1" Margin="4,0" Padding="4,1" CornerRadius="5"
                Background="{DynamicResource PaywallWarningBrush}">
          <TextBlock Text="SHOP" FontSize="8" FontWeight="Black"
                     TextAlignment="Center"
                     Foreground="{DynamicResource PaywallWarningTextBrush}" />
        </Border>
      </Grid>
    </Button>

    <!-- Kept in the visual tree so opening it does not trigger first-use layout work. -->
    <Grid Name="PaywallLayer"
          IsEnabled="{Binding IsPaywallVisible}"
          IsHitTestVisible="{Binding IsPaywallVisible}"
          KeyboardNavigation.TabNavigation="Cycle">
      <Border Name="PaywallScrim"
              Background="{DynamicResource ScrimBrush}"
              Opacity="{Binding PaywallOpacity}"
              PointerPressed="OnPaywallScrimPressed" />
      <Border Name="PaywallSheet" MaxWidth="380" Margin="18"
              HorizontalAlignment="Stretch" VerticalAlignment="Center"
              Opacity="{Binding PaywallOpacity}"
              Background="{DynamicResource PaywallBrush}"
              BorderBrush="{DynamicResource PaywallEdgeBrush}" BorderThickness="1"
              CornerRadius="30" Padding="24,22">
        <StackPanel Spacing="13">
          <Border CornerRadius="10" Padding="10,7"
                  Background="{DynamicResource PaywallWarningBrush}">
            <TextBlock Text="{Binding PaywallBanner}"
                       FontSize="11" FontWeight="Black" TextAlignment="Center"
                       Foreground="{DynamicResource PaywallWarningTextBrush}" />
          </Border>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Width="52" Height="52" CornerRadius="17" Background="{DynamicResource PaywallCyanBrush}"
                    BorderBrush="White" BorderThickness="2">
              <TextBlock Text="💸" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="SumScription ULTRA MAX+++" FontSize="13" FontWeight="Black"
                         Foreground="{DynamicResource PaywallAccentBrush}" />
              <TextBlock Text="100% premium · 0% real payment · 200% audacity" FontSize="10"
                         Foreground="{DynamicResource PaywallSoftBrush}" />
            </StackPanel>
          </Grid>

          <TextBlock Text="{Binding PaywallTitle}" FontSize="29" FontWeight="Bold"
                     LetterSpacing="-0.8" TextWrapping="Wrap" Foreground="White" />
          <TextBlock Text="{Binding PaywallMessage}" FontSize="14" LineHeight="20"
                     TextWrapping="Wrap" Foreground="{DynamicResource PaywallSoftBrush}" />

          <!-- Both offer groups stay measured so the percent screen has no first-use layout spike. -->
          <Grid>
          <StackPanel Spacing="10"
                      Opacity="{Binding ResultOfferOpacity}"
                      IsEnabled="{Binding IsResultPaywall}"
                      IsHitTestVisible="{Binding IsResultPaywall}">
            <Border Padding="4" CornerRadius="14" Background="#26000000"
                    BorderBrush="#52FFFFFF" BorderThickness="1">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                <Button Classes="billing-segment" Classes.active="{Binding IsMonthlyPlans}"
                        TabIndex="1" Content="MONTHLY"
                        AutomationProperties.Name="Show monthly offers"
                        Command="{Binding ShowMonthlyPlansCommand}" />
                <Button Grid.Column="1" Classes="billing-segment" Classes.active="{Binding IsAnnualPlans}"
                        TabIndex="2" Content="ANNUAL"
                        AutomationProperties.Name="Show annual offers"
                        Command="{Binding ShowAnnualPlansCommand}" />
              </Grid>
            </Border>

            <Grid>
            <StackPanel Spacing="8"
                        Opacity="{Binding MonthlyPlansOpacity}"
                        IsEnabled="{Binding IsMonthlyPlans}"
                        IsHitTestVisible="{Binding IsMonthlyPlans}">
            <Button Name="PlanSingleCalculationButton" Classes="plan credit-pack" TabIndex="3"
                    AutomationProperties.Name="Special offer, one result for 4.99 euros"
                    Command="{Binding SelectPlanCommand}" CommandParameter="SingleCalculation">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3">
                  <Border HorizontalAlignment="Left" CornerRadius="6" Padding="7,2"
                          Background="{DynamicResource PaywallWarningBrush}">
                    <TextBlock Text="SPECIAL OFFER" FontSize="8" FontWeight="Black"
                               Foreground="{DynamicResource PaywallWarningTextBrush}" />
                  </Border>
                  <TextBlock Text="One premium result" FontSize="14" FontWeight="Bold" Foreground="White" />
                  <TextBlock Text="Unlocks this calculation only" FontSize="10"
                             Foreground="{DynamicResource PaywallSoftBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                  <TextBlock Text="€4.99" FontSize="20" FontWeight="Black" TextAlignment="Right"
                             Foreground="{DynamicResource PaywallAccentBrush}" />
                  <TextBlock Text="ONE RESULT" FontSize="9" FontWeight="Bold" TextAlignment="Right" Foreground="White" />
                </StackPanel>
              </Grid>
            </Button>
            <Button Name="PlanMonthlyButton" Classes="plan credit-pack" TabIndex="4"
                    AutomationProperties.Name="Monthly Ultra subscription, 74.99 euros per month"
                    Command="{Binding SelectPlanCommand}" CommandParameter="Monthly">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3">
                  <Border HorizontalAlignment="Left" CornerRadius="6" Padding="7,2"
                          Background="{DynamicResource PaywallCyanBrush}">
                    <TextBlock Text="MOST POPULAR" FontSize="8" FontWeight="Black"
                               Foreground="{DynamicResource PaywallWarningTextBrush}" />
                  </Border>
                  <TextBlock Text="Monthly Ultra" FontSize="14" FontWeight="Bold" Foreground="White" />
                  <TextBlock Text="Premium answers, billed monthly" FontSize="10"
                             Foreground="{DynamicResource PaywallSoftBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                  <TextBlock Text="€74.99" FontSize="20" FontWeight="Black" TextAlignment="Right"
                             Foreground="{DynamicResource PaywallAccentBrush}" />
                  <TextBlock Text="PER MONTH" FontSize="9" FontWeight="Bold" TextAlignment="Right" Foreground="White" />
                </StackPanel>
              </Grid>
            </Button>
            </StackPanel>

            <StackPanel Spacing="8"
                        Opacity="{Binding AnnualPlansOpacity}"
                        IsEnabled="{Binding IsAnnualPlans}"
                        IsHitTestVisible="{Binding IsAnnualPlans}">
            <Button Name="PlanAnnualButton" Classes="plan credit-pack" TabIndex="3"
                    AutomationProperties.Name="Annual Standard subscription, 499 euros per year"
                    Command="{Binding SelectPlanCommand}" CommandParameter="Annual">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3">
                  <Border HorizontalAlignment="Left" CornerRadius="6" Padding="7,2"
                          Background="{DynamicResource PaywallCyanBrush}">
                    <TextBlock Text="ANNUAL STANDARD" FontSize="8" FontWeight="Black"
                               Foreground="{DynamicResource PaywallWarningTextBrush}" />
                  </Border>
                  <TextBlock Text="One year of results" FontSize="14" FontWeight="Bold" Foreground="White" />
                  <TextBlock Text="No percentage calculations included" FontSize="10"
                             Foreground="{DynamicResource PaywallSoftBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                  <TextBlock Text="€499" FontSize="20" FontWeight="Black" TextAlignment="Right"
                             Foreground="{DynamicResource PaywallAccentBrush}" />
                  <TextBlock Text="PER YEAR" FontSize="9" FontWeight="Bold" TextAlignment="Right" Foreground="White" />
                </StackPanel>
              </Grid>
            </Button>
            <Button Name="PlanAnnualPremiumButton" Classes="plan credit-pack" TabIndex="4"
                    AutomationProperties.Name="Annual Premium subscription, 699 euros, with one hundred percentage calculations"
                    Command="{Binding SelectPlanCommand}" CommandParameter="AnnualPremium">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3">
                  <Border HorizontalAlignment="Left" CornerRadius="6" Padding="7,2"
                          Background="{DynamicResource PaywallWarningBrush}">
                    <TextBlock Text="BEST VALUE + 100 %" FontSize="8" FontWeight="Black"
                               Foreground="{DynamicResource PaywallWarningTextBrush}" />
                  </Border>
                  <TextBlock Text="Annual Premium" FontSize="14" FontWeight="Bold" Foreground="White" />
                  <TextBlock Text="One year + 100 premium % calculations" FontSize="10"
                             Foreground="{DynamicResource PaywallSoftBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                  <TextBlock Text="€699" FontSize="20" FontWeight="Black" TextAlignment="Right"
                             Foreground="{DynamicResource PaywallAccentBrush}" />
                  <TextBlock Text="PREMIUM YEAR" FontSize="9" FontWeight="Bold" TextAlignment="Right" Foreground="White" />
                </StackPanel>
              </Grid>
            </Button>
            </StackPanel>
            </Grid>
          </StackPanel>

          <StackPanel Spacing="8"
                      Opacity="{Binding PremiumPercentOfferOpacity}"
                      IsEnabled="{Binding IsPremiumPercentPaywall}"
                      IsHitTestVisible="{Binding IsPremiumPercentPaywall}">
            <Button Name="PercentPackOneButton" Classes="plan credit-pack" TabIndex="1"
                    AutomationProperties.Name="One premium percentage calculation, 9.99 euros"
                    Command="{Binding SelectPremiumPercentPackCommand}" CommandParameter="One">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="ONE-TIME % PASS" FontSize="13" FontWeight="Black" Foreground="White" />
                  <TextBlock Text="One calculation. Infinite status." FontSize="10"
                             Foreground="{DynamicResource PaywallSoftBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="€9.99" FontSize="20" FontWeight="Black"
                           Foreground="{DynamicResource PaywallAccentBrush}" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button Name="PercentPackTenButton" Classes="plan credit-pack" TabIndex="2"
                    AutomationProperties.Name="Ten premium percentage calculations, 69.99 euros"
                    Command="{Binding SelectPremiumPercentPackCommand}" CommandParameter="Ten">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="TEN % CALCULATIONS" FontSize="13" FontWeight="Black" Foreground="White" />
                  <TextBlock Text="Imaginary best value" FontSize="10"
                             Foreground="{DynamicResource PaywallSoftBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="€69.99" FontSize="20" FontWeight="Black"
                           Foreground="{DynamicResource PaywallAccentBrush}" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button Name="PercentPackHundredButton" Classes="plan credit-pack" TabIndex="3"
                    AutomationProperties.Name="One hundred premium percentage calculations, 599 euros"
                    Command="{Binding SelectPremiumPercentPackCommand}" CommandParameter="Hundred">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="CORPORATE % VAULT" FontSize="13" FontWeight="Black" Foreground="White" />
                  <TextBlock Text="For quarterly percentage emergencies" FontSize="10"
                             Foreground="{DynamicResource PaywallSoftBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="€599" FontSize="20" FontWeight="Black"
                           Foreground="{DynamicResource PaywallAccentBrush}" VerticalAlignment="Center" />
              </Grid>
            </Button>
          </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
      <Button Name="PaywallCloseButton" Classes="paywall-secondary" TabIndex="4"
              ZIndex="3"
              Opacity="{Binding PaywallOpacity}"
              Width="224" Height="38"
              Margin="0,0,0,18"
              HorizontalAlignment="Center" VerticalAlignment="Bottom"
              Content="{Binding PaywallCloseText}" AutomationProperties.Name="Reject premium offer"
              PointerEntered="OnPaywallClosePointerEntered"
              PointerPressed="OnPaywallClosePointerPressed"
              KeyDown="OnPaywallCloseKeyDown" />
    </Grid>

    <Grid Name="CheckoutLayer" IsVisible="{Binding IsCheckoutVisible}"
          KeyboardNavigation.TabNavigation="Cycle" Background="{DynamicResource ScrimBrush}">
      <Border Name="CheckoutPanel" MaxWidth="360" Margin="24"
              HorizontalAlignment="Stretch" VerticalAlignment="Center"
              Background="{DynamicResource GlassStrongBrush}"
              BorderBrush="{DynamicResource GlassEdgeStrongBrush}" BorderThickness="1"
              CornerRadius="26" Padding="24,22">
        <StackPanel Spacing="16">
          <TextBlock Classes="title" Text="Almost financially irresponsible." TextWrapping="Wrap" />
          <TextBlock Text="{Binding CheckoutPlanLine}" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="{Binding CheckoutNoteLine}" Classes="secondary" TextWrapping="Wrap" />
          <Border Padding="12" CornerRadius="12" Background="{DynamicResource GlassBrush}">
            <TextBlock Text="Parody notice: Nothing is charged and no payment information is collected."
                       Classes="secondary" FontSize="11" TextWrapping="Wrap" />
          </Border>
          <Button Name="CheckoutConfirmButton" Classes="paywall-primary" TabIndex="1"
                  AutomationProperties.Name="Confirm purchase"
                  Command="{Binding ConfirmPurchaseCommand}">
            <TextBlock Text="Confirm purchase" Foreground="{DynamicResource PaywallButtonTextBrush}"
                       FontSize="14" FontWeight="SemiBold" />
          </Button>
          <Button Name="CheckoutCancelButton" Classes="glass" TabIndex="2" MinHeight="42"
                  Content="Back" AutomationProperties.Name="Back"
                  Command="{Binding CancelPurchaseCommand}" />
        </StackPanel>
      </Border>
    </Grid>

    <Grid Name="UpdateNoticeLayer" IsVisible="{Binding IsUpdateNoticeVisible}"
          KeyboardNavigation.TabNavigation="Cycle"
          Background="{DynamicResource ScrimBrush}">
      <Border MaxWidth="360" Margin="24"
              HorizontalAlignment="Stretch" VerticalAlignment="Center"
              Background="{DynamicResource GlassStrongBrush}"
              BorderBrush="{DynamicResource GlassEdgeStrongBrush}" BorderThickness="1"
              CornerRadius="28" Padding="24,22">
        <StackPanel Spacing="15">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="13">
            <Border Width="52" Height="52" CornerRadius="17"
                    Background="{DynamicResource OperatorBrush}">
              <TextBlock Text="↻" FontSize="29" FontWeight="Bold"
                         Foreground="{DynamicResource OperatorTextBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="Update successfully installed" FontSize="18" FontWeight="Bold"
                         TextWrapping="Wrap" />
              <TextBlock Text="Without asking. You're welcome." Classes="secondary" FontSize="12" />
            </StackPanel>
          </Grid>

          <Border Padding="15,13" CornerRadius="16" Background="{DynamicResource GlassBrush}">
            <StackPanel Spacing="9">
              <TextBlock Text="What’s new" FontSize="13" FontWeight="SemiBold" />
              <TextBlock Text="• Improved purchasing opportunities by 31%." Classes="secondary"
                         FontSize="12" TextWrapping="Wrap" />
              <TextBlock Text="• Fixed a rare issue where the calculator focused on calculations."
                         Classes="secondary" FontSize="12" TextWrapping="Wrap" />
              <TextBlock Text="• Added several innovations requested by our revenue department."
                         Classes="secondary" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Button Name="UpdateNoticeContinueButton" Classes="paywall-primary" TabIndex="1"
                  Content="Enjoy the improvements"
                  AutomationProperties.Name="Dismiss update notice"
                  Command="{Binding DismissUpdateNoticeCommand}" />
        </StackPanel>
      </Border>
    </Grid>

    <Grid Name="TipLayer" IsVisible="{Binding IsTipVisible}"
          KeyboardNavigation.TabNavigation="Cycle"
          Background="{DynamicResource ScrimBrush}">
      <Border MaxWidth="360" Margin="24"
              HorizontalAlignment="Stretch" VerticalAlignment="Center"
              Background="{DynamicResource GlassStrongBrush}"
              BorderBrush="{DynamicResource GlassEdgeStrongBrush}" BorderThickness="1"
              CornerRadius="28" Padding="24,22">
        <StackPanel Spacing="16">
          <TextBlock Text="Your result was served successfully." Classes="secondary"
                     FontSize="12" TextAlignment="Center" />
          <TextBlock Text="Tip your calculator?" Classes="title"
                     TextAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Text="It carried the one all by itself and would appreciate recognition."
                     Classes="secondary" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" />

          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <Button Classes="plan" MinHeight="72" Padding="8" TabIndex="1"
                    AutomationProperties.Name="Tip 25 percent"
                    Command="{Binding SelectTipCommand}" CommandParameter="25">
              <StackPanel>
                <TextBlock Text="25%" FontSize="22" FontWeight="Bold" TextAlignment="Center" />
                <TextBlock Text="STANDARD" FontSize="8" FontWeight="Bold" TextAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="1" Classes="plan" MinHeight="72" Padding="8" TabIndex="2"
                    Background="{DynamicResource PaywallCyanBrush}"
                    AutomationProperties.Name="Tip 40 percent, recommended"
                    Command="{Binding SelectTipCommand}" CommandParameter="40">
              <StackPanel>
                <TextBlock Text="40%" FontSize="22" FontWeight="Black" TextAlignment="Center"
                           Foreground="{DynamicResource PaywallButtonTextBrush}" />
                <TextBlock Text="RECOMMENDED" FontSize="8" FontWeight="Black" TextAlignment="Center"
                           Foreground="{DynamicResource PaywallButtonTextBrush}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="2" Classes="plan" MinHeight="72" Padding="8" TabIndex="3"
                    AutomationProperties.Name="Tip 75 percent"
                    Command="{Binding SelectTipCommand}" CommandParameter="75">
              <StackPanel>
                <TextBlock Text="75%" FontSize="22" FontWeight="Bold" TextAlignment="Center" />
                <TextBlock Text="VISIONARY" FontSize="8" FontWeight="Bold" TextAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
              </StackPanel>
            </Button>
          </Grid>

          <Button Name="TipDeclineButton" Classes="glass" MinHeight="40" TabIndex="4"
                  Content="No tip — the numbers felt cold"
                  AutomationProperties.Name="Decline calculator tip"
                  Command="{Binding DeclineTipCommand}" />
        </StackPanel>
      </Border>
    </Grid>

    <Grid Name="DivisionByZeroLayer" IsVisible="{Binding IsDivisionByZeroVisible}"
          KeyboardNavigation.TabNavigation="Cycle"
          Background="{DynamicResource ScrimBrush}">
      <Border MaxWidth="360" Margin="24"
              HorizontalAlignment="Stretch" VerticalAlignment="Center"
              Background="{DynamicResource GlassStrongBrush}"
              BorderBrush="{DynamicResource GlassEdgeStrongBrush}" BorderThickness="1"
              CornerRadius="28" Padding="24,22">
        <StackPanel Spacing="15">
          <Border HorizontalAlignment="Left" CornerRadius="8" Padding="9,5"
                  Background="{DynamicResource PaywallWarningBrush}">
            <TextBlock Text="ENTERPRISE MATHEMATICS" FontSize="9" FontWeight="Black"
                       Foreground="{DynamicResource PaywallWarningTextBrush}" />
          </Border>
          <TextBlock Text="Zero has declined the meeting." Classes="title" TextWrapping="Wrap" />
          <TextBlock Text="Division by zero is currently available only through our Enterprise Consultation Programme. Pricing begins after we understand your organisation’s relationship with reality."
                     Classes="secondary" FontSize="13" LineHeight="19" TextWrapping="Wrap" />
          <Border Padding="13" CornerRadius="14" Background="{DynamicResource GlassBrush}">
            <TextBlock Text="Reference: MATH-0/0 · Severity: commercially promising"
                       Classes="secondary" FontSize="11" TextWrapping="Wrap" />
          </Border>
          <Button Name="DivisionByZeroDismissButton" Classes="paywall-primary" TabIndex="1"
                  Content="Return to supported reality"
                  AutomationProperties.Name="Dismiss division by zero notice"
                  Command="{Binding DismissDivisionByZeroCommand}" />
        </StackPanel>
      </Border>
    </Grid>

    <Panel Name="CelebrationLayer" IsVisible="False" IsHitTestVisible="False">
      <Canvas Name="ConfettiCanvas" />
      <Border Name="PurchaseToast"
              HorizontalAlignment="Center" VerticalAlignment="Top"
              Margin="20,72,20,0" Padding="22,14" CornerRadius="18"
              Background="{DynamicResource PaywallWarningBrush}"
              BorderBrush="White" BorderThickness="2">
        <TextBlock Text="{Binding PurchaseCelebrationText}"
                   FontSize="14" FontWeight="Black" TextAlignment="Center" TextWrapping="Wrap"
                   Foreground="{DynamicResource PaywallWarningTextBrush}" />
      </Border>
    </Panel>
  </Panel>
</Window>
