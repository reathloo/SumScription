<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <LinearGradientBrush x:Key="WindowBackdropBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#F20B1224" Offset="0" />
        <GradientStop Color="#ED172344" Offset="0.56" />
        <GradientStop Color="#F00B1020" Offset="1" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="GlassBrush" Color="#A6243152" />
      <SolidColorBrush x:Key="GlassStrongBrush" Color="#D51B2744" />
      <SolidColorBrush x:Key="GlassHoverBrush" Color="#D936466D" />
      <SolidColorBrush x:Key="GlassPressedBrush" Color="#E1172039" />
      <SolidColorBrush x:Key="GlassEdgeBrush" Color="#38FFFFFF" />
      <SolidColorBrush x:Key="GlassEdgeStrongBrush" Color="#62FFFFFF" />
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF8FBFF" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#BBD3DDF3" />
      <SolidColorBrush x:Key="TextTertiaryBrush" Color="#7EA9B6D1" />
      <SolidColorBrush x:Key="OperatorBrush" Color="#FFF49A58" />
      <SolidColorBrush x:Key="OperatorHoverBrush" Color="#FFFFAE75" />
      <SolidColorBrush x:Key="OperatorPressedBrush" Color="#FFDB7F40" />
      <SolidColorBrush x:Key="OperatorTextBrush" Color="#FF2B1205" />
      <SolidColorBrush x:Key="FunctionBrush" Color="#A6435272" />
      <SolidColorBrush x:Key="FunctionHoverBrush" Color="#CE566888" />
      <SolidColorBrush x:Key="FunctionPressedBrush" Color="#E5323E5D" />
      <SolidColorBrush x:Key="FocusBrush" Color="#FFE9B98C" />
      <SolidColorBrush x:Key="FocusInnerBrush" Color="#FF15203A" />
      <SolidColorBrush x:Key="DangerBrush" Color="#FFFF7B77" />
      <SolidColorBrush x:Key="ScrimBrush" Color="#B8040812" />
      <LinearGradientBrush x:Key="PaywallBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#FA3511A8" Offset="0" />
        <GradientStop Color="#FCF20B73" Offset="0.44" />
        <GradientStop Color="#FCFF6138" Offset="0.76" />
        <GradientStop Color="#FA5420D7" Offset="1" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="PaywallEdgeBrush" Color="#B8FFFFFF" />
      <SolidColorBrush x:Key="PaywallAccentBrush" Color="#FFFFF36D" />
      <SolidColorBrush x:Key="PaywallSoftBrush" Color="#D8FFE9F0" />
      <SolidColorBrush x:Key="PaywallButtonBrush" Color="#FF54F3FF" />
      <SolidColorBrush x:Key="PaywallButtonTextBrush" Color="#FF4A075D" />
      <SolidColorBrush x:Key="PaywallWarningBrush" Color="#FFFFF36D" />
      <SolidColorBrush x:Key="PaywallWarningTextBrush" Color="#FF47102F" />
      <SolidColorBrush x:Key="PaywallCyanBrush" Color="#FF54F3FF" />
      <SolidColorBrush x:Key="PaywallHotBrush" Color="#FFFF5A8F" />
      <SolidColorBrush x:Key="OrbOneBrush" Color="#884E6FFF" />
      <SolidColorBrush x:Key="OrbTwoBrush" Color="#66EE6C9A" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Light">
      <LinearGradientBrush x:Key="WindowBackdropBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#EEF2F8FF" Offset="0" />
        <GradientStop Color="#E7DCE7FA" Offset="0.56" />
        <GradientStop Color="#EEF6F0F4" Offset="1" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="GlassBrush" Color="#9FFFFFFF" />
      <SolidColorBrush x:Key="GlassStrongBrush" Color="#D9FFFFFF" />
      <SolidColorBrush x:Key="GlassHoverBrush" Color="#F4FFFFFF" />
      <SolidColorBrush x:Key="GlassPressedBrush" Color="#CBE4E8F1" />
      <SolidColorBrush x:Key="GlassEdgeBrush" Color="#72FFFFFF" />
      <SolidColorBrush x:Key="GlassEdgeStrongBrush" Color="#9AFFFFFF" />
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF14203A" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C34A5872" />
      <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8A66728A" />
      <SolidColorBrush x:Key="OperatorBrush" Color="#FFF09254" />
      <SolidColorBrush x:Key="OperatorHoverBrush" Color="#FFFFA86E" />
      <SolidColorBrush x:Key="OperatorPressedBrush" Color="#FFDA783A" />
      <SolidColorBrush x:Key="OperatorTextBrush" Color="#FF351603" />
      <SolidColorBrush x:Key="FunctionBrush" Color="#BFD4DBE9" />
      <SolidColorBrush x:Key="FunctionHoverBrush" Color="#E2E8ECF5" />
      <SolidColorBrush x:Key="FunctionPressedBrush" Color="#D0C2CBDD" />
      <SolidColorBrush x:Key="FocusBrush" Color="#FF9B4B18" />
      <SolidColorBrush x:Key="FocusInnerBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="DangerBrush" Color="#FFB42329" />
      <SolidColorBrush x:Key="ScrimBrush" Color="#7A11182A" />
      <LinearGradientBrush x:Key="PaywallBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#FA4314B6" Offset="0" />
        <GradientStop Color="#FCF51379" Offset="0.44" />
        <GradientStop Color="#FCFF6A3E" Offset="0.76" />
        <GradientStop Color="#FA5B24DC" Offset="1" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="PaywallEdgeBrush" Color="#B8FFFFFF" />
      <SolidColorBrush x:Key="PaywallAccentBrush" Color="#FFFFF36D" />
      <SolidColorBrush x:Key="PaywallSoftBrush" Color="#E8FFF3F6" />
      <SolidColorBrush x:Key="PaywallButtonBrush" Color="#FF54F3FF" />
      <SolidColorBrush x:Key="PaywallButtonTextBrush" Color="#FF4A075D" />
      <SolidColorBrush x:Key="PaywallWarningBrush" Color="#FFFFF36D" />
      <SolidColorBrush x:Key="PaywallWarningTextBrush" Color="#FF47102F" />
      <SolidColorBrush x:Key="PaywallCyanBrush" Color="#FF54F3FF" />
      <SolidColorBrush x:Key="PaywallHotBrush" Color="#FFFF5A8F" />
      <SolidColorBrush x:Key="OrbOneBrush" Color="#5B5579FF" />
      <SolidColorBrush x:Key="OrbTwoBrush" Color="#4CEE719D" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <FontFamily x:Key="SansFont">SF Pro Display, SF Pro Text, Segoe UI Variable Text, Segoe UI, Inter</FontFamily>
  <FontFamily x:Key="NumberFont">SF Pro Display, SF Pro Rounded, SF Pro Text, Segoe UI Variable Display, Segoe UI</FontFamily>
</ResourceDictionary>
