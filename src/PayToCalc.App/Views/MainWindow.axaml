<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PayToCalc.App.ViewModels"
        x:Class="PayToCalc.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="payToCalc"
        Width="420"
        Height="700"
        MinWidth="390"
        MinHeight="650"
        Background="Transparent"
        TransparencyLevelHint="Mica, AcrylicBlur, Blur"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="48"
        FontFamily="{StaticResource SansFont}"
        WindowStartupLocation="CenterScreen">

  <Panel Background="{DynamicResource WindowBackdropBrush}">
    <!-- Zwei ruhige Farbkörper geben dem transparenten Fenster Tiefe. -->
    <Ellipse Width="260" Height="260" Margin="-110,-80,0,0"
             HorizontalAlignment="Left" VerticalAlignment="Top"
             Fill="{DynamicResource OrbOneBrush}" IsHitTestVisible="False">
      <Ellipse.Effect><BlurEffect Radius="70" /></Ellipse.Effect>
    </Ellipse>
    <Ellipse Width="230" Height="230" Margin="0,0,-100,70"
             HorizontalAlignment="Right" VerticalAlignment="Bottom"
             Fill="{DynamicResource OrbTwoBrush}" IsHitTestVisible="False">
      <Ellipse.Effect><BlurEffect Radius="76" /></Ellipse.Effect>
    </Ellipse>

    <Grid RowDefinitions="54,*,Auto,Auto"
          Margin="20,10,20,18"
          IsEnabled="{Binding !IsOverlayOpen}">
      <Grid Grid.Row="0" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
          <Border Width="28" Height="28" CornerRadius="9"
                  Background="{DynamicResource OperatorBrush}">
            <TextBlock Text="=" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource OperatorTextBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="payToCalc" FontSize="17" FontWeight="SemiBold"
                     VerticalAlignment="Center" />
        </StackPanel>
      </Grid>

      <!-- Die Anzeige ist die große, ruhige Glasfläche; der Verlauf bleibt bewusst sekundär. -->
      <Border Grid.Row="1" Margin="0,4,0,14" CornerRadius="26"
              Background="{DynamicResource GlassStrongBrush}"
              BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1"
              ClipToBounds="True">
        <Grid RowDefinitions="Auto,112,*" Margin="22,18,22,16">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
            <TextBlock Classes="meta tertiary" Text="Verlauf" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="glass" Content="C" Width="34" Height="30" Padding="0"
                    TabIndex="1" AutomationProperties.Name="Eintrag löschen"
                    Command="{Binding ClearEntryCommand}" />
            <Button Grid.Column="2" Classes="glass" Content="⌫" Width="34" Height="30" Padding="0"
                    TabIndex="2" AutomationProperties.Name="Rücktaste"
                    Command="{Binding BackspaceCommand}" />
          </Grid>

          <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="0,10,0,0">
            <TextBlock Classes="expression" Text="{Binding ExpressionText}"
                       AutomationProperties.Name="Ausdruck" />
            <Grid Grid.Row="1">
              <TextBlock Name="ResultLine" Classes="result"
                         Classes.masked="{Binding IsResultMasked}"
                         Text="{Binding DisplayResult}"
                         IsVisible="{Binding !HasError}"
                         AutomationProperties.Name="{Binding ResultAutomationName}"
                         VerticalAlignment="Bottom">
                <TextBlock.Transitions>
                  <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.18" /></Transitions>
                </TextBlock.Transitions>
              </TextBlock>
              <TextBlock Name="ErrorLine" Classes="error" Text="{Binding DisplayResult}"
                         IsVisible="{Binding HasError}" AutomationProperties.Name="Fehler"
                         VerticalAlignment="Bottom" />
              <Border IsVisible="{Binding IsResultMasked}"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,2,8" Padding="10,6" CornerRadius="10"
                      Background="{DynamicResource OperatorBrush}">
                <TextBlock Text="GESPERRT" FontSize="10" FontWeight="Bold" LetterSpacing="0.7"
                           Foreground="{DynamicResource OperatorTextBrush}" />
              </Border>
            </Grid>
          </Grid>

          <ScrollViewer Grid.Row="2" Margin="0,10,0,0" MinHeight="52" MaxHeight="112"
                        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Panel>
              <TextBlock Classes="history tertiary" Text="Noch keine Berechnungen"
                         IsVisible="{Binding IsHistoryEmpty}" />
              <ItemsControl ItemsSource="{Binding History}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HistoryRow">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,3" Opacity="{Binding Opacity}">
                      <TextBlock Classes="history" Text="{Binding Expression}"
                                 AutomationProperties.Name="{Binding AutomationName}" />
                      <TextBlock Grid.Column="1" Classes="history-result" Margin="14,0,0,0"
                                 Text="{Binding ResultText}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Panel>
          </ScrollViewer>
        </Grid>
      </Border>

      <Grid Name="Keypad" Grid.Row="2"
            RowDefinitions="60,60,60,60,60"
            ColumnDefinitions="*,*,*,*"
            RowSpacing="8" ColumnSpacing="8">
        <Button Name="AcButton" Grid.Row="0" Grid.Column="0" Classes="calc function" Content="AC" TabIndex="3"
                AutomationProperties.Name="Alles löschen" Command="{Binding ClearAllCommand}" />
        <Button Grid.Row="0" Grid.Column="1" Classes="calc function" Content="±" TabIndex="4"
                AutomationProperties.Name="Vorzeichen wechseln" Command="{Binding ToggleSignCommand}" />
        <Button Grid.Row="0" Grid.Column="2" Classes="calc function" Content="%" TabIndex="5"
                AutomationProperties.Name="Prozent" Command="{Binding PercentCommand}" />
        <Button Grid.Row="0" Grid.Column="3" Classes="calc operator" Content="÷" TabIndex="6"
                AutomationProperties.Name="Geteilt" Command="{Binding OperatorCommand}" CommandParameter="/" />

        <Button Grid.Row="1" Grid.Column="0" Classes="calc digit" Content="7" TabIndex="7"
                AutomationProperties.Name="Sieben" Command="{Binding DigitCommand}" CommandParameter="7" />
        <Button Grid.Row="1" Grid.Column="1" Classes="calc digit" Content="8" TabIndex="8"
                AutomationProperties.Name="Acht" Command="{Binding DigitCommand}" CommandParameter="8" />
        <Button Grid.Row="1" Grid.Column="2" Classes="calc digit" Content="9" TabIndex="9"
                AutomationProperties.Name="Neun" Command="{Binding DigitCommand}" CommandParameter="9" />
        <Button Grid.Row="1" Grid.Column="3" Classes="calc operator" Content="×" TabIndex="10"
                AutomationProperties.Name="Mal" Command="{Binding OperatorCommand}" CommandParameter="*" />

        <Button Grid.Row="2" Grid.Column="0" Classes="calc digit" Content="4" TabIndex="11"
                AutomationProperties.Name="Vier" Command="{Binding DigitCommand}" CommandParameter="4" />
        <Button Grid.Row="2" Grid.Column="1" Classes="calc digit" Content="5" TabIndex="12"
                AutomationProperties.Name="Fünf" Command="{Binding DigitCommand}" CommandParameter="5" />
        <Button Grid.Row="2" Grid.Column="2" Classes="calc digit" Content="6" TabIndex="13"
                AutomationProperties.Name="Sechs" Command="{Binding DigitCommand}" CommandParameter="6" />
        <Button Grid.Row="2" Grid.Column="3" Classes="calc operator" Content="−" TabIndex="14"
                AutomationProperties.Name="Minus" Command="{Binding OperatorCommand}" CommandParameter="-" />

        <Button Grid.Row="3" Grid.Column="0" Classes="calc digit" Content="1" TabIndex="15"
                AutomationProperties.Name="Eins" Command="{Binding DigitCommand}" CommandParameter="1" />
        <Button Grid.Row="3" Grid.Column="1" Classes="calc digit" Content="2" TabIndex="16"
                AutomationProperties.Name="Zwei" Command="{Binding DigitCommand}" CommandParameter="2" />
        <Button Grid.Row="3" Grid.Column="2" Classes="calc digit" Content="3" TabIndex="17"
                AutomationProperties.Name="Drei" Command="{Binding DigitCommand}" CommandParameter="3" />
        <Button Grid.Row="3" Grid.Column="3" Classes="calc operator" Content="+" TabIndex="18"
                AutomationProperties.Name="Plus" Command="{Binding OperatorCommand}" CommandParameter="+" />

        <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Classes="calc digit" Content="0" TabIndex="19"
                AutomationProperties.Name="Null" Command="{Binding DigitCommand}" CommandParameter="0" />
        <Button Grid.Row="4" Grid.Column="2" Classes="calc digit" Content="," TabIndex="20"
                AutomationProperties.Name="Dezimaltrennzeichen" Command="{Binding SeparatorCommand}" />
        <Button Grid.Row="4" Grid.Column="3" Classes="calc operator" Content="=" TabIndex="21"
                AutomationProperties.Name="Ergebnis" Command="{Binding EqualsCommand}" />
      </Grid>

      <Grid Grid.Row="3" Margin="0,12,0,0">
        <Button Name="UnlockButton" Classes="glass" Content="Premium-Angebot erneut öffnen" TabIndex="22"
                IsVisible="{Binding CanReopenPaywall}" AutomationProperties.Name="Premium-Angebot erneut öffnen"
                Command="{Binding OpenPaywallCommand}" />
      </Grid>
    </Grid>

    <!-- Absichtlich aufdringliche, aber eindeutig fiktive Parodie-Paywall. -->
    <Grid Name="PaywallLayer" IsVisible="{Binding IsPaywallVisible}"
          KeyboardNavigation.TabNavigation="Cycle"
          Background="{DynamicResource ScrimBrush}"
          PointerPressed="OnPaywallScrimPressed">
      <Border Name="PaywallSheet" MaxWidth="380" Margin="18"
              HorizontalAlignment="Stretch" VerticalAlignment="Center"
              Background="{DynamicResource PaywallBrush}"
              BorderBrush="{DynamicResource PaywallEdgeBrush}" BorderThickness="1"
              CornerRadius="30" Padding="24,22">
        <Border.Effect><DropShadowEffect Color="#B0000000" BlurRadius="32" OffsetY="16" Opacity="0.7" /></Border.Effect>
        <StackPanel Spacing="13">
          <Border CornerRadius="10" Padding="10,7"
                  Background="{DynamicResource PaywallWarningBrush}">
            <TextBlock Text="⚡ NUR JETZT: DIE TEUERSTE 2 DER WELT ⚡"
                       FontSize="11" FontWeight="Black" TextAlignment="Center"
                       Foreground="{DynamicResource PaywallWarningTextBrush}" />
          </Border>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Width="52" Height="52" CornerRadius="17" Background="{DynamicResource PaywallCyanBrush}"
                    BorderBrush="White" BorderThickness="2">
              <TextBlock Text="💸" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="PayToCalc ULTRA MAX+++" FontSize="13" FontWeight="Black"
                         Foreground="{DynamicResource PaywallAccentBrush}" />
              <TextBlock Text="100 % fiktiv · 0 % echter Kauf · 200 % frech" FontSize="10"
                         Foreground="{DynamicResource PaywallSoftBrush}" />
            </StackPanel>
          </Grid>

          <TextBlock Text="{Binding PaywallTitle}" FontSize="29" FontWeight="Bold"
                     LetterSpacing="-0.8" TextWrapping="Wrap" Foreground="White">
            <TextBlock.Effect><DropShadowEffect Color="#FF54F3FF" BlurRadius="10" Opacity="0.75" /></TextBlock.Effect>
          </TextBlock>
          <TextBlock Text="{Binding PaywallMessage}" FontSize="14" LineHeight="20"
                     TextWrapping="Wrap" Foreground="{DynamicResource PaywallSoftBrush}" />

          <Button Name="PlanSubscriptionButton" Classes="plan" TabIndex="1"
                  AutomationProperties.Name="Fiktives Ultra-Abo, 29,99 Euro pro Woche"
                  Command="{Binding SelectPlanCommand}" CommandParameter="Subscription">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3">
                <Border HorizontalAlignment="Left" CornerRadius="6" Padding="7,2"
                        Background="{DynamicResource PaywallCyanBrush}">
                  <TextBlock Text="BELIEBTESTER GELDVERNICHTER" FontSize="8" FontWeight="Black"
                             Foreground="{DynamicResource PaywallWarningTextBrush}" />
                </Border>
                <TextBlock Text="Wöchentlich Ultra" FontSize="14" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="Für Menschen mit sehr teuren Ergebnissen" FontSize="10" Foreground="{DynamicResource PaywallSoftBrush}" />
              </StackPanel>
              <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock Text="29,99 €" FontSize="20" FontWeight="Black" TextAlignment="Right"
                           Foreground="{DynamicResource PaywallAccentBrush}" />
                <TextBlock Text="PRO WOCHE!" FontSize="9" FontWeight="Bold" TextAlignment="Right" Foreground="White" />
              </StackPanel>
            </Grid>
          </Button>
          <Button Name="PlanOneTimeButton" Classes="plan" TabIndex="2"
                  AutomationProperties.Name="Fiktiver Lebenskauf, 499,99 Euro"
                  Command="{Binding SelectPlanCommand}" CommandParameter="OneTime">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3">
                <Border HorizontalAlignment="Left" CornerRadius="6" Padding="7,2"
                        Background="{DynamicResource PaywallHotBrush}">
                  <TextBlock Text="NUR FÜR MATHE-FANS" FontSize="8" FontWeight="Black" Foreground="White" />
                </Border>
                <TextBlock Text="Lebenslang rechnen" FontSize="14" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="Ein Schnäppchen für eine einzelne Zahl" FontSize="10" Foreground="{DynamicResource PaywallSoftBrush}" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="499,99 €" FontSize="20" FontWeight="Black"
                         VerticalAlignment="Center" Foreground="{DynamicResource PaywallAccentBrush}" />
            </Grid>
          </Button>

          <Button Classes="paywall-primary" TabIndex="3"
                  AutomationProperties.Name="Fiktiven Demo-Kauf starten"
                  Command="{Binding SelectPlanCommand}" CommandParameter="Subscription">
            <TextBlock Text="JA! DIE 2 GEHÖRT MIR" Foreground="{DynamicResource PaywallButtonTextBrush}"
                       FontSize="14" FontWeight="Black" />
          </Button>
          <Button Name="PaywallCloseButton" Classes="paywall-secondary" TabIndex="4"
                  Content="{Binding PaywallCloseText}" AutomationProperties.Name="Paywall ablehnen"
                  Command="{Binding ClosePaywallCommand}" />
          <TextBlock Text="{Binding PaywallDismissalHint}" FontSize="10" TextAlignment="Center"
                     Foreground="{DynamicResource PaywallSoftBrush}" />
        </StackPanel>
      </Border>
    </Grid>

    <Grid Name="CheckoutLayer" IsVisible="{Binding IsCheckoutVisible}"
          KeyboardNavigation.TabNavigation="Cycle" Background="{DynamicResource ScrimBrush}">
      <Border Name="CheckoutPanel" MaxWidth="360" Margin="24"
              HorizontalAlignment="Stretch" VerticalAlignment="Center"
              Background="{DynamicResource GlassStrongBrush}"
              BorderBrush="{DynamicResource GlassEdgeStrongBrush}" BorderThickness="1"
              CornerRadius="26" Padding="24,22">
        <Border.Effect><DropShadowEffect Color="#B0000000" BlurRadius="28" OffsetY="14" Opacity="0.65" /></Border.Effect>
        <StackPanel Spacing="16">
          <TextBlock Classes="title" Text="Fast reich geworden." TextWrapping="Wrap" />
          <TextBlock Text="{Binding CheckoutPlanLine}" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="{Binding CheckoutNoteLine}" Classes="secondary" TextWrapping="Wrap" />
          <Border Padding="12" CornerRadius="12" Background="{DynamicResource GlassBrush}">
            <TextBlock Text="Parodie: Es wird nichts berechnet und keine Zahlungsinformation erfasst."
                       Classes="secondary" FontSize="11" TextWrapping="Wrap" />
          </Border>
          <Button Name="CheckoutConfirmButton" Classes="paywall-primary" TabIndex="1"
                  AutomationProperties.Name="Fiktiven Kauf bestätigen"
                  Command="{Binding ConfirmPurchaseCommand}">
            <TextBlock Text="Fiktiven Kauf bestätigen" Foreground="{DynamicResource PaywallButtonTextBrush}"
                       FontSize="14" FontWeight="SemiBold" />
          </Button>
          <Button Name="CheckoutCancelButton" Classes="glass" TabIndex="2" MinHeight="42"
                  Content="Zurück" AutomationProperties.Name="Zurück"
                  Command="{Binding CancelPurchaseCommand}" />
        </StackPanel>
      </Border>
    </Grid>
  </Panel>
</Window>
